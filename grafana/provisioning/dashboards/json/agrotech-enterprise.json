{
  "id": null,
  "uid": "agrotech-enterprise",
  "title": "AgroTech Enterprise - API and Edge",
  "tags": ["agrotech", "api", "edge", "land-portfolio"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API throughput by endpoint and status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (endpoint, status_code) (rate(agro_http_requests_total[5m]))",
          "legendFormat": "{{endpoint}} {{status_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "API request latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(agro_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{endpoint}} p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Edge CPU utilization (demo values)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "agro_edge_node_cpu_utilization_ratio",
          "legendFormat": "{{region}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Edge memory utilization (demo values)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "agro_edge_node_memory_utilization_ratio",
          "legendFormat": "{{region}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Land portfolio query success vs errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(agro_land_portfolio_queries_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Active M&A queries (GET /items/ demonstration)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "agro_ma_land_queries_active",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Edge node status by region (demo values)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "agro_edge_nodes",
          "legendFormat": "{{region}} {{status}}",
          "refId": "A"
        }
      ]
    }
  ]
}
